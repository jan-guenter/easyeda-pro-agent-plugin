{
  "name": "easyeda-pro-control-plugin",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jan-guenter/easyeda-pro-agent-plugin.git",
    "directory": "plugins/easyeda-pro-control"
  },
  "packageManager": "npm@11.16.0",
  "type": "module",
  "scripts": {
    "build": "npm run sanitizer:check && npm run sql:reader:check && node scripts/build-server.ts",
    "bridge:build": "node scripts/build-authenticated-bridge.ts",
    "bridge:lint": "oxlint --config .oxlintrc.bridge.json --type-aware --deny-warnings easyeda-bridge-extension/src easyeda-bridge-extension/tests easyeda-bridge-extension/scripts easyeda-bridge-extension/vitest.config.ts",
    "bridge:provision": "node scripts/provision-bridge-token.ts",
    "bridge:test": "vitest run --root easyeda-bridge-extension --config vitest.config.ts",
    "bridge:typecheck": "tsc --noEmit -p easyeda-bridge-extension/tsconfig.json && tsc --noEmit -p easyeda-bridge-extension/tsconfig.test.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.bridge-stubs.json",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware . --fix",
    "sanitizer:build": "node scripts/build-descriptor-sanitizer.ts --write",
    "sanitizer:check": "node scripts/build-descriptor-sanitizer.ts --check",
    "sql:reader:check": "node scripts/generate-sqlite-inventory-program.ts --check",
    "sql:reader:update": "node scripts/generate-sqlite-inventory-program.ts --write",
    "test": "node --import ./scripts/test-isolation.ts --test server/tests/*.test.ts",
    "validate": "node scripts/validate-plugin.ts",
    "skills:validate": "node scripts/validate-skills.ts",
    "api:coverage:check": "node scripts/generate-api-coverage.ts --check",
    "api:coverage:update": "node scripts/generate-api-coverage.ts --write",
    "repository:validate": "node scripts/validate-repository.ts",
    "doctor": "node scripts/doctor.ts --offline",
    "probe:installed:offline": "node scripts/probe-installed-offline-catalog.ts",
    "compatibility:check": "node scripts/reviewed-compatibility.ts --check",
    "compatibility:update": "node scripts/reviewed-compatibility.ts --write",
    "verify": "npm run typecheck && npm run bridge:typecheck && npm run bridge:lint && npm run lint && npm run api:coverage:check && npm run build && npm run compatibility:check && npm test && npm run bridge:test && npm run skills:validate && npm run validate"
  },
  "engines": {
    "node": "24.18.0"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "acorn": "8.17.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
