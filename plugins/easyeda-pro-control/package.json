{
  "name": "easyeda-pro-control-plugin",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jan-guenter/easyeda-pro-agent-plugin.git",
    "directory": "plugins/easyeda-pro-control"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build-server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware . --fix",
    "test": "node --test server/tests/*.test.ts",
    "validate": "node scripts/validate-plugin.ts",
    "doctor": "node scripts/doctor.ts --offline",
    "compatibility:check": "node scripts/reviewed-compatibility.ts --check",
    "compatibility:update": "node scripts/reviewed-compatibility.ts --write",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run compatibility:check && npm test && npm run validate"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.25.12",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
