        "easyeda_control_export": { "approval_mode": "prompt" },
        "easyeda_control_plan": { "approval_mode": "prompt" },
        "easyeda_control_apply": { "approval_mode": "prompt" },
        "easyeda_control_verify": { "approval_mode": "prompt" },
        "easyeda_control_rollback": { "approval_mode": "prompt" },
        "easyeda_control_save_reopen": { "approval_mode": "prompt" },
        "easyeda_control_checkpoint": { "approval_mode": "prompt" },
        "easyeda_control_recover_incomplete": { "approval_mode": "prompt" },
        "easyeda_control_evidence_recover": { "approval_mode": "prompt" },
        "easyeda_control_evidence_verify": { "approval_mode": "approve" },
        "easyeda_control_artifact_read": { "approval_mode": "approve" }
